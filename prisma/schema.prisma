generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ExpiryStatus {
  OK
  EXPIRING_SOON
  EXPIRED
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  role        UserRole  @default(USER)
  enabled     Boolean   @default(true)
  personId    String?
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  person    Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  otpCodes  OtpCode[]
  sessions  Session[]
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email, createdAt])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Person {
  id                 String       @id @default(cuid())
  firstName          String
  middleName         String?
  lastName           String
  nationality        String
  purpose            String
  passportNumber     String
  passportIssueDate  DateTime
  passportExpiryDate DateTime
  eidIssueDate       DateTime
  eidExpiryDate      DateTime

  photoBlobKey    String?
  photoBlobUrl    String?
  passportBlobKey String?
  passportBlobUrl String?
  eidFrontBlobKey String?
  eidFrontBlobUrl String?
  eidBackBlobKey  String?
  eidBackBlobUrl  String?
  pdfBlobKey      String?
  pdfBlobUrl      String?

  passportStatus ExpiryStatus @default(OK)
  eidStatus      ExpiryStatus @default(OK)
  notifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users    User[]
  projects ProjectMember[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]

  @@unique([name])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  personId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([projectId, personId])
  @@index([personId])
}
